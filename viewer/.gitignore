# GitHub-Pages entry is generated by build-pages.mjs
pages/index.html
# The Pages data (base.bin + base-lite.bin + 2062+ gene files, ~550MB) is NOT kept on
# this source branch — it's committed only to the orphan gh-pages deploy branch.
# Regenerate locally with: export_data.py --pages [--imputed-genes]
pages/data/
# copied in by build-pages.mjs from assets/
pages/assets/
