# Site-specific Slurm options for the stand-alone launchers (scripts/**/run_*.sh
# and the other *.sh files with #SBATCH headers). The launchers themselves carry
# only portable resource requests (time, memory, cpus, a generic GPU); the
# partition, QOS and GPU type of the cluster they run on live here.
#
# Submit a launcher through config/sbatch.sh, which reads its
# "# bimp-sbatch: <class>" line and adds the options for that class:
#
#   bash config/sbatch.sh scripts/identity/run_tangram_remap_grid.sh <args>
#
# Edit the values below for your cluster, or point BIMP_SBATCH_ENV at a copy.
# Drivers that submit several jobs (scripts/caste_de/cnmf_gsea/run_pipeline.sh,
# pipelines/subcellular/save_lp_all.sh) source this file too.
# The Snakemake pipelines take their Slurm settings from config.yaml in this
# directory instead.

BIMP_SBATCH_CPU="--partition=main"
BIMP_SBATCH_GPU="--partition=main.gpu"
BIMP_SBATCH_GPU_H100="--partition=main.gpu --gres=gpu:h100:1"
# Wall-time classes for jobs under 1 hour and under 1 day.
BIMP_SBATCH_SHORT="--qos=1hr"
BIMP_SBATCH_DAY="--qos=1day"
